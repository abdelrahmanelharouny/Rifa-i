// Rifa'i Phase 1 example program

fn add(a: int, b: int) -> int {
    return a + b;
}

fn greet(name: string) -> void {
    print("Hello, " + name + "!\n");
}

let age: int = 21;
let price: float = 19.5;
let active: bool = true;
let language: string = "Rifa'i";

greet(language);

if (age >= 18 and active) {
    print("Adult");
} else {
    print("Minor");
}

let count: int = 3;
while (count > 0) {
    print(count);
    count = count - 1;
}

let sum: int = add(10, 20);
print(sum);
