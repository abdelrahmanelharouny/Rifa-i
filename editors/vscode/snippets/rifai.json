{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:int}) -> ${4:int} {",
      "    $0:return ${2:arg};",
      "}"
    ],
    "description": "Declare a typed Rifa'i function"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:value});"
    ],
    "description": "Print a value"
  },
  "Variable": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:int} = ${3:0};"
    ],
    "description": "Declare a typed variable"
  },
  "If / Else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    ${2:}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create an if / else statement"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Create a while loop"
  },
  "Main Example": {
    "prefix": "rifai-main",
    "body": [
      "fn main() -> void {",
      "    let message: string = \"Hello, Rifa'i!\";",
      "    print(message);",
      "}"
    ],
    "description": "Starter Rifa'i program"
  },
  "Generic Function": {
    "prefix": "fng",
    "body": [
      "fn ${1:identity}<${2:T}>(${3:value}: ${2:T}) -> ${2:T} {",
      "    ${0:return ${3:value};}",
      "}"
    ],
    "description": "Declare a generic Rifa'i function with inferred type arguments"
  }
}
