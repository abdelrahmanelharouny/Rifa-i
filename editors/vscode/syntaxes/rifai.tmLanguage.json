{
  "scopeName": "source.rifai",
  "name": "Rifa'i",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-declarations" },
    { "include": "#function-calls" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.rifai", "match": "//.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rifai",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.rifai", "match": "\\\\(?:[\"\\\\ntr])" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.rifai", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.rifai", "match": "\\b[0-9]+\\b" }
      ]
    },
    "function-declarations": {
      "name": "meta.function.rifai",
      "begin": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": { "1": { "name": "entity.name.function.rifai" } },
      "end": "(?=\\{)"
    },
    "function-calls": {
      "patterns": [
        { "name": "entity.name.function.call.rifai", "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()" }
      ]
    },
    "keywords": {
      "name": "keyword.control.rifai",
      "match": "\\b(?:fn|let|return|if|else|while|print|and|or|not)\\b"
    },
    "types": {
      "name": "storage.type.rifai",
      "match": "\\b(?:int|float|bool|string|void)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.rifai",
      "match": "\\b(?:true|false)\\b"
    },
    "operators": {
      "name": "keyword.operator.rifai",
      "match": "->|==|!=|<=|>=|[+*/%<>=-]"
    }
  }
}
