(* ============================================================================
 * Rifa'i Programming Language — Formal EBNF Grammar (Version 3.1 / Phase 16)
 * ============================================================================
 *
 * Phase 15 adds relative source imports, nominal structs and unit enums,
 * inferred local declarations, and postfix member access.
 * Phase 16 adds for loops, break/continue, and short-circuit logical evaluation.
 *
 * Imports are top-level and resolve relative to the importing file, confined
 * to the root source directory. Imported declarations share one global
 * compilation namespace. Cycles are rejected.
 * ============================================================================ *)

program        ::= declaration* EOF ;

declaration    ::= import_decl
                 | struct_decl
                 | enum_decl
                 | fn_decl
                 | statement ;

import_decl    ::= "import" STRING ";" ;

struct_decl    ::= "struct" IDENTIFIER "{"
                   struct_field ( ( "," | ";" ) struct_field )*
                   ( "," | ";" )?
                   "}" ;

struct_field   ::= IDENTIFIER ":" type_spec ;

enum_decl      ::= "enum" IDENTIFIER "{"
                   IDENTIFIER ( "," IDENTIFIER )* ","?
                   "}" ;

fn_decl        ::= "fn" IDENTIFIER "(" param_list? ")" "->" return_type block ;

param_list     ::= param ( "," param )* ;
param          ::= IDENTIFIER ":" type_spec ;

type_spec      ::= primitive_type ( "[" "]" )?
                 | IDENTIFIER ;

primitive_type ::= "int" | "float" | "bool" | "string" ;
return_type    ::= type_spec | "void" ;

statement      ::= var_decl
                 | assign_stmt
                 | if_stmt
                 | while_stmt
                 | for_stmt
                 | break_stmt
                 | continue_stmt
                 | return_stmt
                 | print_stmt
                 | block
                 | expr_stmt ;

block          ::= "{" statement* "}" ;

var_decl       ::= "let" IDENTIFIER ( ":" type_spec )? "=" expression ";" ;

assign_stmt    ::= postfix_expr "=" expression ";" ;

if_stmt        ::= "if" "(" expression ")" block
                   ( "else" ( if_stmt | block ) )? ;

while_stmt     ::= "while" "(" expression ")" block ;

for_stmt       ::= "for" "(" for_initializer? ";" expression? ";" for_increment? ")" block ;
for_initializer ::= var_decl | for_clause ;
for_increment  ::= for_clause ;
for_clause     ::= postfix_expr "=" expression | expression ;

break_stmt     ::= "break" ";" ;
continue_stmt  ::= "continue" ";" ;

return_stmt    ::= "return" expression? ";" ;
print_stmt     ::= "print" "(" expression ")" ";" ;
expr_stmt      ::= expression ";" ;

expression     ::= logic_or ;
logic_or       ::= logic_and ( "or" logic_and )* ;
logic_and      ::= equality ( "and" equality )* ;
equality       ::= comparison ( ( "==" | "!=" ) comparison )* ;
comparison     ::= term ( ( "<" | ">" | "<=" | ">=" ) term )* ;
term           ::= factor ( ( "+" | "-" ) factor )* ;
factor         ::= unary ( ( "*" | "/" | "%" ) unary )* ;
unary          ::= ( "-" | "not" ) unary | postfix_expr ;

postfix_expr   ::= primary ( "[" expression "]" | "." IDENTIFIER )* ;

primary        ::= INTEGER
                 | FLOAT
                 | STRING
                 | "true"
                 | "false"
                 | fn_call
                 | IDENTIFIER
                 | "(" expression ")"
                 | array_literal ;

array_literal  ::= "[" ( expression ( "," expression )* )? "]" ;
fn_call        ::= IDENTIFIER "(" arg_list? ")" ;
arg_list       ::= expression ( "," expression )* ;

IDENTIFIER     ::= ( ASCII_LETTER | "_" ) ( ASCII_LETTER | DIGIT | "_" )* ;
INTEGER        ::= DIGIT+ ;
FLOAT          ::= DIGIT+ "." DIGIT+ ;
STRING         ::= '"' ( STRING_CHAR | ESCAPE_SEQ )* '"' ;
ESCAPE_SEQ     ::= '\"' | '\\' | '\n' | '\t' | '\r' ;
ASCII_LETTER   ::= "A".."Z" | "a".."z" ;
DIGIT          ::= "0".."9" ;
